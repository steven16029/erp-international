FROM quay.io/sclorg/nodejs-20-c9s:latest
ENV NPM_CONFIG_CACHE=/tmp/.npm
WORKDIR /opt/app-root/src
COPY . .
RUN mkdir -p src && \
    mv -f server*.js src/server.js 2>/dev/null || true && \
    npm init -y && \
    npm install express cors pg dotenv --no-audit --no-fund
EXPOSE 8080
CMD ["node", "src/server.js"]
